  <itcc-ci:IntroduzioneNotaIntegrativaAltreInformazioni contextRef="cai_i">&lt;html&gt;&lt;head&gt;&lt;/head&gt;&lt;body&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 0px ;text-indent:37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt;Non ci sono partecipazioni in imprese controllate e collegate.&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 0px ;text-indent:37.8000005086263px ;line-height:150% ;"&gt; &lt;/p&gt;&lt;p style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;text-align:center;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;"&gt;AMMONTARE DEI CREDITI E DEBITI DI DURATA RESIDUA SUPERIORE A 5 ANNI E GARANZIE REALI CONNESSE:&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-weight:bold;font-style:normal;font-size:16px;font-family:times new roman;"&gt;CREDITI&lt;/span&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt; = si precisa che nessun credito iscritto dell’&lt;/span&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt;attivo del bilancio è di durata residua superiore a cinque anni.&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-weight:bold;font-style:normal;font-size:16px;font-family:times new roman;"&gt;DEBITI&lt;/span&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt; = si precisa che nessun debito iscritto nel passivo del bilancio è di durata residua superiore a cinque anni.&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt; &lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt; &lt;/p&gt;&lt;p style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;text-align:center;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;"&gt;ONERI FINANZIARI IMPUTATI NELL’&lt;/span&gt;&lt;span style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;"&gt;ESERCIZIO A VALORI ISCRITTI NELL’&lt;/span&gt;&lt;span style="font-style:normal;text-decoration:underline;font-size:16px;font-family:times new roman;"&gt;ATTIVO:&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt;Nessun onere finanziario è stato imputato nell’&lt;/span&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt;esercizio, a valori iscritti nell’&lt;/span&gt;&lt;span style="font-style:normal;font-size:16px;font-family:times new roman;"&gt;attivo dello Stato Patrimoniale.&lt;/span&gt;&lt;/p&gt;&lt;p style="font-style:normal;font-size:16px;font-family:times new roman;text-align:justify;margin:0px 37.7333323160807px 0px 37.8000005086263px ;line-height:150% ;"&gt; &lt;/p&gt;&lt;p style="font-style:normal;text-decor