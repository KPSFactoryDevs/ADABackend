    &lt;style media="all" type="text/css" xml:space="preserve"&gt;
      body {font-family:'Times New Roman',serif;font-size:16.0px}
      h1 {margin-left:0;margin-right:0;margin-top:0;margin-bottom:0;border:none;padding:0;font-family:'Times New Roman',serif;font-weight:bold;font-size:18.666668px;clear:left}
    &lt;/style&gt;
